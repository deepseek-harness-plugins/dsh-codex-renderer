{
  "name": "@deepseekharness-plugin/dsh-codex-renderer",
  "version": "0.3.2",
  "icon": "./icon.svg",
  "description": "DeepSeek Harness 的 Codex 风格表格、Mermaid 和音视频渲染组件",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg",
    "locale/*.json",
    "docs/codex-media-parity.md",
    "docs/COMPATIBILITY.md",
    "assets/*.png",
    "assets/sample.wav",
    "assets/sample.mp4",
    "scripts/media-demo.mjs",
    "docs/codex-mermaid-parity.md",
    "assets/*.gif"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host": "node scripts/host-test.mjs",
    "test:boot": "node scripts/boot-test.mjs",
    "demo:media": "node scripts/media-demo.mjs",
    "check": "npm run build && npm test && npm run test:host && npm run test:boot"
  },
  "devDependencies": {
    "@mermaid-js/layout-elk": "1.0.1",
    "esbuild": "0.25.10",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "12.1.0",
    "playwright": "1.56.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  }
}
